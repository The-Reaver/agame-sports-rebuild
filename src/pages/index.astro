---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import GuidedTour from '../components/GuidedTour.astro';
import { facility } from '../data/facility';
import { primaryNav } from '../data/sitemap';

const sportLinks = primaryNav.find((item) => item.label === 'Sports')?.children ?? [];

const champions = [
	{ division: '5th–7th Grade', team: 'Cowboys' },
	{ division: '3rd–4th Grade', team: 'Patriots' },
	{ division: 'K–2nd Grade', team: 'Rams' },
];
---

<BaseLayout
	title="Indoor Youth Sports in New Rochelle, NY"
	description="A-Game Sports is New Rochelle's indoor home for youth sports — baseball, basketball, soccer, lacrosse, camps, and more, since 2013."
>
	<section id="tour-hero" class="bg-turf-950 px-6 py-20 text-center text-chalk-50 sm:py-28">
		<p class="font-mono text-sm tracking-wide text-gold-400">{facility.anniversaryNote}</p>
		<h1 class="mx-auto mt-4 max-w-3xl text-5xl leading-tight sm:text-6xl">
			Where New Rochelle kids come to get better — at sports, and beyond.
		</h1>
		<p class="mx-auto mt-5 max-w-2xl text-lg text-turf-100">
			Indoor training, camps, and leagues for nearly every sport, every age, every skill level — one facility, year-round.
		</p>
		<div class="mt-8 flex flex-wrap justify-center gap-3">
			<a href="#find-your-sport" class="btn-primary">Find Your Sport</a>
			<a href="/contact/" class="btn-secondary">Book a Tour</a>
		</div>
	</section>

	<section id="find-your-sport" class="mx-auto max-w-6xl px-6 py-16">
		<h2 class="font-display text-2xl text-turf-900 sm:text-3xl">Find Your Sport</h2>
		<p class="mt-2 max-w-2xl text-turf-700">
			Every sport we teach, one tap away. Not sure which fits? <a href="/contact/" class="font-semibold text-turf-900 underline hover:text-gold-700">Call us</a> and we'll point you to the right program.
		</p>
		<ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
			{
				sportLinks.map((s) => (
					<li>
						<a
							href={s.href}
							class="card flex h-full items-center justify-center p-5 text-center font-display text-sm text-turf-900 transition-colors hover:border-gold-400 hover:bg-turf-50"
						>
							{s.label}
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section id="tour-programs" class="bg-turf-50 px-6 py-16">
		<div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-3">
			<article class="card">
				<h2 class="font-display text-lg text-turf-900">Camps & Seasonal Programs</h2>
				<p class="mt-2 text-sm text-turf-700">
					Summer camps, school break camps, and fall leagues for nearly every sport we teach.
				</p>
				<a href="/summer-camps/" class="mt-4 inline-block text-sm font-semibold text-turf-900 underline hover:text-gold-700">
					See Summer Camps
				</a>
			</article>
			<article class="card">
				<h2 class="font-display text-lg text-turf-900">Travel Teams</h2>
				<p class="mt-2 text-sm text-turf-700">
					Westchester Fire (baseball), Westchester Heat (softball), and travel flag football for players ready to compete beyond the rec level.
				</p>
				<a href="/travel-teams/" class="mt-4 inline-block text-sm font-semibold text-turf-900 underline hover:text-gold-700">
					See Travel Teams
				</a>
			</article>
			<article class="card">
				<h2 class="font-display text-lg text-turf-900">Birthdays & Events</h2>
				<p class="mt-2 text-sm text-turf-700">
					Book the whole facility for a birthday party, corporate retreat, or private rental — indoors or out.
				</p>
				<a href="/birthdays-events-rentals/" class="mt-4 inline-block text-sm font-semibold text-turf-900 underline hover:text-gold-700">
					Plan an Event
				</a>
			</article>
		</div>
	</section>

	<section class="mx-auto max-w-4xl px-6 py-16 text-center">
		<h2 class="font-display text-2xl text-turf-900">Winter Flag Football League Champions</h2>
		<p class="mt-2 text-turf-700">Congratulations to this season's division winners.</p>
		<div class="mt-6 grid gap-4 sm:grid-cols-3">
			{
				champions.map((c) => (
					<div class="card">
						<p class="font-mono text-xs uppercase tracking-wide text-turf-600">{c.division}</p>
						<p class="mt-1 font-display text-xl text-gold-700">{c.team}</p>
					</div>
				))
			}
		</div>
	</section>

	<CTASection />
	<GuidedTour />
</BaseLayout>
