---
import type { CollectionEntry } from 'astro:content';
import Hero from '../../components/Hero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FactList from '../../components/FactList.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import CTASection from '../../components/CTASection.astro';
import { getBreadcrumb, getSiblings, getHub } from '../../utils/navHelpers';

interface Props {
	entry: CollectionEntry<'pages'>;
	href: string;
	Content: any;
}
const { entry, href, Content } = Astro.props;
const { data } = entry;
const siblings = getSiblings(href);
const hub = getHub(href);
---

<Breadcrumb crumbs={getBreadcrumb(href)} />
<Hero
	eyebrow={data.heroEyebrow}
	headline={data.heroHeadline}
	sub={data.heroSub}
	ctaLabel={data.ctaLabel}
	ctaHref={data.ctaHref}
	tone="light"
/>
<div class="mx-auto grid max-w-5xl gap-10 px-6 py-12 lg:grid-cols-[1fr_18rem]">
	<article class="prose prose-headings:font-display prose-headings:uppercase prose-a:text-turf-700 max-w-none">
		<Content />
	</article>
	<aside class="space-y-4">
		<FactList facts={data.facts} ageRange={data.ageRange} priceNote={data.priceNote} scheduleNote={data.scheduleNote} />
		{
			hub && (
				<a href={hub.href} class="card block text-sm font-semibold text-turf-700 hover:border-gold-400">
					&larr; Back to {hub.label}
				</a>
			)
		}
	</aside>
</div>
<RelatedLinks title="You Might Also Like" links={siblings} />
<CTASection ctaLabel={data.ctaLabel} ctaHref={data.ctaHref} />
