---
interface Crumb {
	label: string;
	href: string;
}
interface Props {
	crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mx-auto max-w-5xl px-6 pt-6 text-xs text-turf-700">
	<ol class="flex flex-wrap items-center gap-1">
		{
			crumbs.map((c, i) => (
				<li class="flex items-center gap-1">
					{i > 0 && <span aria-hidden="true">/</span>}
					{i === crumbs.length - 1 ? (
						<span aria-current="page" class="font-semibold text-turf-900">
							{c.label}
						</span>
					) : (
						<a href={c.href} class="hover:text-turf-700 hover:underline">
							{c.label}
						</a>
					)}
				</li>
			))
		}
	</ol>
</nav>
