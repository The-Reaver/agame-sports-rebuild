---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { facility } from '../data/facility';

interface Props {
	eyebrow?: string;
	headline: string;
	sub?: string;
	ctaLabel?: string;
	ctaHref?: string;
	tone?: 'dark' | 'light';
	secondaryLabel?: string;
	secondaryHref?: string;
	image?: ImageMetadata;
	imageAlt?: string;
}
const {
	eyebrow,
	headline,
	sub,
	ctaLabel,
	ctaHref,
	tone = 'dark',
	secondaryLabel = 'Call or Visit',
	secondaryHref = facility.phoneHref,
	image,
	imageAlt,
} = Astro.props;

const showSecondary = secondaryHref !== ctaHref;
const showImage = Boolean(image && imageAlt);
---

<section class:list={['px-6 py-16 sm:py-20', tone === 'dark' ? 'bg-turf-950 text-chalk-50' : 'bg-turf-50 text-turf-950']}>
	{
		showImage ? (
			<div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-2">
				<div>
					{eyebrow && (
						<p class:list={['font-mono text-sm tracking-wide', tone === 'dark' ? 'text-gold-400' : 'text-gold-700']}>{eyebrow}</p>
					)}
					<h1 class="mt-3 text-4xl leading-tight sm:text-5xl">{headline}</h1>
					{sub && (
						<p class:list={['mt-4 max-w-2xl text-base sm:text-lg', tone === 'dark' ? 'text-turf-100' : 'text-turf-700']}>{sub}</p>
					)}
					{ctaLabel && ctaHref && (
						<div class="mt-8 flex flex-wrap gap-3">
							<a href={ctaHref} class="btn-primary">
								{ctaLabel}
							</a>
							{showSecondary && (
								<a
									href={secondaryHref}
									class:list={[
										'btn-secondary',
										tone === 'light' &&
											'border-turf-950 text-turf-950 hover:bg-turf-950 hover:text-chalk-50 focus-visible:bg-turf-950 focus-visible:text-chalk-50',
									]}
								>
									{secondaryLabel}
								</a>
							)}
						</div>
					)}
				</div>
				<Image
					src={image as ImageMetadata}
					alt={imageAlt as string}
					width={640}
					height={480}
					class="w-full rounded-[var(--radius-card)] object-cover shadow-lg"
				/>
			</div>
		) : (
			<div class="mx-auto max-w-4xl text-center">
				{eyebrow && <p class:list={['font-mono text-sm tracking-wide', tone === 'dark' ? 'text-gold-400' : 'text-gold-700']}>{eyebrow}</p>}
				<h1 class="mt-3 text-4xl leading-tight sm:text-5xl">{headline}</h1>
				{sub && <p class:list={['mx-auto mt-4 max-w-2xl text-base sm:text-lg', tone === 'dark' ? 'text-turf-100' : 'text-turf-700']}>{sub}</p>}
				{
					ctaLabel && ctaHref && (
						<div class="mt-8 flex flex-wrap justify-center gap-3">
							<a href={ctaHref} class="btn-primary">
								{ctaLabel}
							</a>
							{showSecondary && (
								<a
									href={secondaryHref}
									class:list={[
										'btn-secondary',
										tone === 'light' &&
											'border-turf-950 text-turf-950 hover:bg-turf-950 hover:text-chalk-50 focus-visible:bg-turf-950 focus-visible:text-chalk-50',
									]}
								>
									{secondaryLabel}
								</a>
							)}
						</div>
					)
				}
			</div>
		)
	}
</section>
