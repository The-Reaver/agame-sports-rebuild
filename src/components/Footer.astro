---
import { facility } from '../data/facility';
import { sitemap } from '../data/sitemap';
---

<footer class="border-t border-turf-800 bg-turf-950 text-chalk-100">
	<div class="mx-auto max-w-7xl px-6 py-12">
		<div class="grid gap-8 md:grid-cols-4">
			<div>
				<p class="font-display text-lg text-chalk-50">A-Game <span class="text-gold-400">Sports</span></p>
				<p class="mt-3 text-sm text-turf-100">{facility.address.full}</p>
				<p class="mt-1 text-sm">
					<a href={facility.phoneHref} class="hover:text-gold-300">{facility.phone}</a>
				</p>
				<p class="text-sm">
					<a href={`mailto:${facility.email}`} class="hover:text-gold-300">{facility.email}</a>
				</p>
				<ul class="mt-4 space-y-1 text-sm text-turf-100">
					{facility.hours.map((h) => <li>{h.days}: {h.time}</li>)}
				</ul>
				<p class="mt-2 text-xs text-turf-100">{facility.hoursNote}</p>
				<div class="mt-4 flex gap-3">
					<a href={facility.social.facebook} class="hover:text-gold-300" aria-label="A-Game Sports on Facebook">Facebook</a>
					<a href={facility.social.instagram} class="hover:text-gold-300" aria-label="A-Game Sports on Instagram">Instagram</a>
					<a href={facility.social.twitter} class="hover:text-gold-300" aria-label="A-Game Sports on Twitter">Twitter</a>
				</div>
			</div>

			<div class="md:col-span-3 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
				{
					sitemap.map((group) => (
						<div>
							<h2 class="font-display text-xs tracking-wide text-gold-400">{group.group}</h2>
							<ul class="mt-2 space-y-1 text-sm">
								{group.entries.map((entry) => (
									<li>
										<a href={entry.href} class="text-turf-100 hover:text-gold-300">{entry.label}</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>

		<div class="mt-10 flex flex-col gap-2 border-t border-turf-800 pt-6 text-xs text-turf-100 sm:flex-row sm:items-center sm:justify-between">
			<p>&copy; {new Date().getFullYear()} A-Game Sports. All rights reserved.</p>
			<div class="flex gap-4">
				<a href="/policies/" class="hover:text-gold-300">Policies</a>
				<a href="/release-forms/" class="hover:text-gold-300">Release Forms</a>
				<a href="/privacy-policy/" class="hover:text-gold-300">Privacy Policy</a>
				<a href="/terms/" class="hover:text-gold-300">Terms</a>
			</div>
		</div>
	</div>
</footer>
